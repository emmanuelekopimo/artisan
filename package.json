{
  "name": "artisan",
  "version": "1.0.0",
  "private": true,
  "description": "Artisan — find verified plumbers, electricians, tailors and mechanics near you.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:deploy": "npm run db:migrate && npm run db:seed",
    "images": "tsx scripts/generate-images.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "docs:pdf": "tsx scripts/build-docs.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "next": "^16.3.8",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@playwright/test": "1.56",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "lucide-static": "^1.49.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
